{
    "$schema": "http://json-schema.org/draft-06/schema",
    "$id":"trossen_widowx_leader_follower_driver_crospi.json",
    "type":"object",
    "properties":{
        "is-trossen_widowx_leader_follower_driver_crospi" : {
            "description":"(experimental) To indicate that the TELEOPERATED (NON-AUTONOMOUS) tasks will be executed using the trossen_widowx_leader_follower_driver_crospi driver when running on the real robot.",
            "type":"boolean",
            "const": true
          }
    },
    "required":["is-trossen_widowx_leader_follower_driver_crospi"],
    "additionalProperties": true,
    "dependencies":{
        "is-trossen_widowx_leader_follower_driver_crospi":{
          "required":["ip_address_follower", "ip_address_leader", "control_mode", "periodicity", "lead_gain"],
          "properties":{
            "ip_address_leader" : {
                    "description":"IP address of the leader robot using Ipv4 format.",
                    "type":"string",
                    "pattern": "^(25[0-5]|2[0-4][0-9]|1[0-9]{2}|[1-9]?[0-9])\\.(25[0-5]|2[0-4][0-9]|1[0-9]{2}|[1-9]?[0-9])\\.(25[0-5]|2[0-4][0-9]|1[0-9]{2}|[1-9]?[0-9])\\.(25[0-5]|2[0-4][0-9]|1[0-9]{2}|[1-9]?[0-9])$",
                    "default": "192.168.1.2"
            },
            "ip_address_follower" : {
                    "description":"IP address of the follower robot using Ipv4 format.",
                    "type":"string",
                    "pattern": "^(25[0-5]|2[0-4][0-9]|1[0-9]{2}|[1-9]?[0-9])\\.(25[0-5]|2[0-4][0-9]|1[0-9]{2}|[1-9]?[0-9])\\.(25[0-5]|2[0-4][0-9]|1[0-9]{2}|[1-9]?[0-9])\\.(25[0-5]|2[0-4][0-9]|1[0-9]{2}|[1-9]?[0-9])$",
                    "default": "192.168.2.3"
            },
            "control_mode": {
                "description": "Control mode for the follower robot arm.",
                "type": "string",
                "enum": ["JOINT_POSITION", "JOINT_VELOCITY", "JOINT_POSITION_WITH_FEEDBACK"]
            },
            "periodicity" : {
                "description":"Periodicity in which the integration will be performed in seconds. 1/periodicity is the update frequency in Hz.",
                "type":"number",
                "default": 0.005,
                "minimum": 0
            },
            "lead_gain" : {
                "description":"Gain to compensate for delays",
                "type":"number",
                "default": 4,
                "minimum": 0
            },
            "safety_velocity_threshold" : {
                "description":"Threshold for safety velocity. If any of the joints of one of the robots exceeds this velocity, the driver will stop both robots. Units are in radians per second.",
                "type":"number",
                "default": 0.5,
                "minimum": 0
            }
          }
        }
      }
}